# ==============================================================================
# SmritiSaathi Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or configure in Vercel Project Settings.

# GEMINI_API_KEY: Required for server-side Gemini AI companion features (App Router API routes).
# In Google AI Studio, this is automatically injected.
# On Vercel, set this under Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where the application is hosted (e.g., https://smritisaathi.vercel.app).
# Used for metadata generation, callback endpoints, and internal service links.
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_APP_ENV: Deployment environment ('development' | 'staging' | 'production').
NEXT_PUBLIC_APP_ENV="development"

# NEXT_PUBLIC_DEFAULT_PORTAL: Default portal route redirect ('patient' | 'caregiver' | 'practitioner' | 'home').
NEXT_PUBLIC_DEFAULT_PORTAL="home"

